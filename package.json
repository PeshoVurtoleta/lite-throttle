{
  "name": "@zakkster/lite-throttle",
  "version": "1.2.0",
  "description": "Zero-GC reactive throttle on @zakkster/lite-signal. Timer-based and rAF-aligned variants. Intent-guarded, synchronous emit, no per-change allocations.",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./index.js",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "Throttle.js",
    "ThrottleRAF.js",
    "_shared.js",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE.txt"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:gc": "node --expose-gc --test test/*.test.js",
    "bench": "node --expose-gc bench/benchmark.mjs",
    "verify": "npm run test:gc && npm run bench"
  },
  "keywords": [
    "throttle",
    "raf",
    "requestAnimationFrame",
    "signal",
    "signals",
    "reactive",
    "zero-gc",
    "zero-allocation",
    "lite-signal",
    "performance",
    "twitch-extension"
  ],
  "peerDependencies": {
    "@zakkster/lite-signal": "^1.2.0"
  },
  "devDependencies": {
    "@zakkster/lite-signal": "^1.3.0",
    "lodash.throttle": "^4.1.1"
  },
  "homepage": "https://github.com/PeshoVurtoleta/lite-throttle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-throttle.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-throttle/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
